{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Read(.env*.local)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)"
    ]
  },
  "autoMemoryEnabled": false
}

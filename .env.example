# Copy to .env.local and fill in from the flex-idle-dev project
# (Supabase dashboard > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix with NEXT_PUBLIC_ or use in browser code.
# Admin screens, sign-in and tests use it to manage accounts.
SUPABASE_SECRET_KEY=
# Live only (Vercel Production): the IP allowlist. Not needed locally.
# See docs/firewall.md.
# ALLOWED_IPS=[{"ip": "203.0.113.5", "label": "Steven home"}]
